			(ref "D6")
			(value "1N5711")
			(footprint "Diode_THT:D_DO-35_SOD27_P7.62mm_Horizontal")
			(description "Schottky diode")
			(fields
				(field
					(name "VERIFY") "ATtiny-only rail +3V3_MCU: diode-OR of +3V3D (D6) and UPDI header VCC (D5) so a programmer cannot back-feed +3V3D. Same 1N5711 as EKM D5 (no LCSC/MPN). MCU VDD ~2.9-3.0 V (0.3-0.4 V drop): check ATtiny VIH/VIL vs CP2102N TXD (3.3 V VIO, exceeds MCU VDD by ~0.35 V) and OLED/Si5351 3.3 V logic; I/O pull-ups moved to +3V3_MCU. With only programmer power, MCU pins can back-power unpowered CP2102N/OLED/Si5351 via their ESD diodes.")
				(field
					(name "Footprint") "Diode_THT:D_DO-35_SOD27_P7.62mm_Horizontal")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Schottky diode")
			)
